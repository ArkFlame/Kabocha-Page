---
const target = import.meta.env.BASE_URL.replace(/\/$/, "") + "/sponsor/";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Sponsorship - Kabocha</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={"0; url=" + target} />
    <link rel="canonical" href={target} />
  </head>
  <body>
    <p>Redirecting to <a href={target}>sponsorship</a>.</p>
  </body>
</html>
